    add('web-eval', c_web_eval, [(('js',), {}), (('--tab',), {}), (('--port',), {'type': int, 'default': 9222})])
    add('web-log', c_web_log, [(('--ms',), {'type': int, 'default': 2500}), (('--tab',), {}), (('--all',), {'action': 'store_true'}), (('--port',), {'type': int, 'default': 9222})])
    add('web-net', c_web_net, [(('--ms',), {'type': int, 'default': 2500}), (('--tab',), {}), (('--all',), {'action': 'store_true'}), (('--port',), {'type': int, 'default': 9222})])
