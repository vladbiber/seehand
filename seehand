    add('web-launch', c_web_launch, [(('url',), {'nargs': '?'}), (('--browser',), {'default': 'chrome'}), (('--keep',), {'action': 'store_true'}), (('--port',), {'type': int, 'default': 9222})])
    add('web-login', c_web_login, [(('--browser',), {'default': 'chrome'}), (('--profile',), {'default': 'Default'}), (('--yes',), {'action': 'store_true'}), (('--tab',), {}), (('--port',), {'type': int, 'default': 9222})])
    add('web-kill', c_web_kill, [(('--browser',), {'default': 'chrome'}), (('--port',), {'type': int, 'default': 9222})])
    add('web-tabs', c_web_tabs, [(('--port',), {'type': int, 'default': 9222})])
